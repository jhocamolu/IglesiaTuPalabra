# =====================================================================
# CONFIGURACIÓN DE ENTORNO - IGLESIA TU PALABRA
# =====================================================================

# Puerto del servidor
PORT=3000
NODE_ENV=development

# Seguridad JWT para el Panel Administrativo
JWT_SECRET=tu_palabra_secreto_super_seguro_2026_jwt_token_key
JWT_EXPIRES_IN=7d

# Configuración de Base de Datos MySQL
# (Si no configuras estas variables o el servidor MySQL no está disponible,
# la aplicación activará automáticamente el almacenamiento en memoria con datos semilla)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_password_mysql
DB_NAME=tupalabra_db

# URLs y Configuración de despliegue
APP_URL=http://localhost:3000
