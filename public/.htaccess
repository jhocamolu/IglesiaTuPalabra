# =====================================================================
# CONFIGURACIÓN HTACCESS PARA CPANEL - IGLESIA TU PALABRA
# Compatible con PHP 8.1 API y React SPA (Vite)
# =====================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Enrutar llamadas al Backend PHP 8.1 (/api/* -> /api/index.php)
  RewriteCond %{REQUEST_URI} ^/api/(.*)$ [NC]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^api/(.*)$ api/index.php [QSA,L]

  # 2. Servir archivos físicos existentes (imágenes, CSS, JS, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. Redirigir el resto al index.html para la navegación SPA de React
  RewriteRule ^ index.html [L]
</IfModule>

# Tipos MIME para módulos JavaScript modernos
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType application/json .json
</IfModule>

# Compresión GZIP para máxima velocidad de carga
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json
</IfModule>

# Cabeceras de seguridad
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
